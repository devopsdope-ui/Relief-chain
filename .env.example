# ReliefChain — Environment Configuration Template
# ==============================================================================
# Copy this file to .env:   cp .env.example .env
# Then edit .env with your values.
# NEVER commit .env to git.
# ==============================================================================

# ── Core Settings (required) ──────────────────────────────────────────────────

# Deterministic simulation seed — change to explore different scenarios
SIMULATION_SEED=42

# SQLite database path (relative to backend/)
DATABASE_URL=sqlite:///./reliefchain.db

# Backend server port
BACKEND_PORT=8000

# Frontend origin (used for CORS allow-list — must match your dev server)
FRONTEND_URL=http://localhost:5173

# JWT signing secret — set a strong random string (≥32 chars) in production
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-secret

# ── Vite Frontend Variables (must be prefixed VITE_) ─────────────────────────

# URL the browser will call for the REST API
VITE_API_URL=http://localhost:8000

# ── Map Tiles ─────────────────────────────────────────────────────────────────
# The app uses FREE, key-less tile sources by default:
#   1. CARTO (dark_all / light_all) — free with attribution
#   2. OpenStreetMap — free with attribution
#   3. Offline vector fallback from bundled GeoJSON
# No API key is required for any of these.

# ── Optional Third-Party Keys (leave blank to use free alternatives) ──────────
# CARTO basemaps API key (removes watermark from CARTO raster tiles)
VITE_CARTO_API_KEY=
# MAPTILER_API_KEY=
# MAPBOX_TOKEN=
# GOOGLE_MAPS_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
